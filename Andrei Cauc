<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SafeSpace — Global Anonymous Support Community</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        bgCream: '#FAF8F5',
                        sage: {
                            50: '#F4F7F5',
                            100: '#E4EBE6',
                            200: '#C5D6CC',
                            500: '#4A6B5D',
                            600: '#3A574A',
                            700: '#2C443A',
                            800: '#1F332B',
                            900: '#14221C',
                        },
                        slateText: '#2C302E',
                        mutedText: '#626865'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #FAF8F5;
            color: #2C302E;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .blur-preview {
            filter: blur(6px);
            user-select: none;
            pointer-events: none;
        }
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #FAF8F5;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94A3B8;
        }
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="min-h-full flex flex-col antialiased">

    <!-- 1. TOP GLOBAL EMERGENCY BANNER -->
    <div class="bg-sage-900 text-white text-xs sm:text-sm py-2.5 px-4 shadow-inner">
        <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-2">
            <div class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="font-medium">In immediate danger or crisis? Confidential help is available worldwide 24/7.</span>
            </div>
            <button onclick="openHelplineModal()" class="underline hover:text-sage-100 font-semibold transition flex items-center gap-1.5">
                <i class="fa-solid fa-earth-americas"></i> View Global Crisis Helplines
            </button>
        </div>
    </div>

    <!-- 2. MAIN HEADER & NAVIGATION -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-6xl mx-auto px-4 py-3 sm:py-4 flex flex-wrap items-center justify-between gap-3">
            <!-- Brand Logo -->
            <a href="#" onclick="switchTab('feed'); return false;" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-sage-100 text-sage-600 flex items-center justify-center font-bold text-xl group-hover:bg-sage-600 group-hover:text-white transition-all shadow-sm">
                    <i class="fa-solid fa-hand-holding-heart"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xl font-bold tracking-tight text-sage-800 leading-none">SafeSpace</span>
                        <span class="text-[10px] uppercase tracking-wider font-bold bg-sage-50 text-sage-700 px-2 py-0.5 rounded-full border border-sage-200">Global</span>
                    </div>
                    <span class="text-xs text-mutedText font-medium">A judgment-free sanctuary for every voice</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-gray-600">
                <button onclick="switchTab('feed')" id="navTab-feed" class="hover:text-sage-700 transition pb-1 border-b-2 border-sage-600 text-sage-800">
                    <i class="fa-solid fa-stream mr-1.5 text-xs"></i> Stories Feed
                </button>
                <button onclick="switchTab('rules')" id="navTab-rules" class="hover:text-sage-700 transition pb-1 border-b-2 border-transparent">
                    <i class="fa-solid fa-shield-cat mr-1.5 text-xs"></i> Community Rules
                </button>
                <button onclick="openHelplineModal()" class="hover:text-sage-700 transition pb-1">
                    <i class="fa-solid fa-life-ring mr-1.5 text-xs"></i> Crisis Helplines
                </button>
            </nav>

            <!-- User Status & Quick Testing Switcher -->
            <div class="flex items-center gap-2 sm:gap-3">
                <!-- Status Badge -->
                <div id="statusBadgeContainer">
                    <!-- Dynamic rendering -->
                </div>

                <!-- Admin/Testing Mode Toggle -->
                <button onclick="toggleUserRole()" title="Switch between Visitor and Lifetime Member view for testing" 
                    class="flex items-center gap-1.5 text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 rounded-xl font-medium transition border border-gray-200">
                    <i class="fa-solid fa-arrows-rotate text-sage-600"></i>
                    <span id="toggleRoleBtnText" class="hidden sm:inline">Test Visitor/Member</span>
                </button>

                <!-- Post Story Button -->
                <button onclick="handleCreateStoryClick()" class="bg-sage-600 hover:bg-sage-700 text-white px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold shadow-sm hover:shadow transition flex items-center gap-2">
                    <i class="fa-solid fa-pen-nib"></i>
                    <span>Share Story</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 3. HERO & VALUE PROPOSITION -->
    <section class="bg-gradient-to-b from-sage-50/80 via-bgCream to-bgCream border-b border-sage-100 py-8 sm:py-12 px-4">
        <div class="max-w-4xl mx-auto text-center space-y-4">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white text-sage-800 border border-sage-200 shadow-sm">
                <i class="fa-solid fa-lock text-sage-600"></i> 100% Anonymous & Compassionately Moderated
            </div>
            <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
                One euro. Zero noise. A safe place to be heard.
            </h1>
            <p class="text-gray-600 text-sm sm:text-lg max-w-2xl mx-auto leading-relaxed">
                Whether you're enduring silent struggles, recovering from abuse, or facing life's daily pressures—you don't have to carry it alone. Speak freely and connect with genuine human empathy.
            </p>

            <!-- Visitor Callout Card (Visible when Visitor) -->
            <div id="heroVisitorCallout" class="mt-6 bg-white p-5 sm:p-6 rounded-2xl border border-sage-200 shadow-sm max-w-2xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-5 text-left">
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2 text-sage-800 font-bold text-base">
                        <i class="fa-solid fa-ticket text-sage-600"></i> Lifetime Access — €1.00 (One-Time Payment)
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed">
                        Why €1? This tiny entry barrier permanently eliminates bots, spam, trolls, and advertisers, ensuring a quiet, respectful sanctuary. Pay once, belong forever.
                    </p>
                </div>
                <button onclick="openPaymentModal()" class="w-full sm:w-auto shrink-0 bg-sage-600 hover:bg-sage-700 text-white font-bold text-sm px-6 py-3 rounded-xl shadow transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-unlock"></i> Unlock Access (€1)
                </button>
            </div>
        </div>
    </section>

    <!-- 4. MAIN CONTAINER (STORIES FEED / COMMUNITY RULES) -->
    <main class="max-w-6xl mx-auto px-4 py-6 sm:py-8 flex-1 w-full">
        
        <!-- FEED VIEW -->
        <div id="view-feed" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- LEFT & CENTER: FEED CONTENT -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Search & Category Filters -->
                <div class="bg-white p-4 rounded-2xl border border-gray-200 shadow-sm space-y-3">
                    <!-- Search Bar -->
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                        <input type="text" id="searchInput" oninput="renderStories()" placeholder="Search stories, topics, or keywords..." 
                            class="w-full pl-10 pr-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-sage-500 transition">
                    </div>

                    <!-- Filter Pills -->
                    <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-semibold no-scrollbar">
                        <button onclick="filterCategory('all')" id="catBtn-all" class="cat-btn bg-sage-600 text-white px-4 py-2 rounded-xl shrink-0 transition">
                            All Stories
                        </button>
                        <button onclick="filterCategory('Everyday Struggles')" id="catBtn-Everyday Struggles" class="cat-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-2 rounded-xl shrink-0 transition">
                            🌧️ Everyday Struggles
                        </button>
                        <button onclick="filterCategory('Abuse & Trauma')" id="catBtn-Abuse & Trauma" class="cat-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-2 rounded-xl shrink-0 transition">
                            💔 Abuse & Trauma
                        </button>
                        <button onclick="filterCategory('Healing & Advice')" id="catBtn-Healing & Advice" class="cat-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-2 rounded-xl shrink-0 transition">
                            🌱 Healing & Advice
                        </button>
                        <button onclick="filterCategory('Relationships & Family')" id="catBtn-Relationships & Family" class="cat-btn bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-2 rounded-xl shrink-0 transition">
                            🏠 Relationships & Family
                        </button>
                    </div>
                </div>

                <!-- Feed Container -->
                <div id="storiesFeedContainer" class="space-y-5">
                    <!-- Stories injected via JavaScript -->
                </div>

            </div>

            <!-- RIGHT COLUMN: SIDEBAR -->
            <aside class="space-y-6">
                
                <!-- Membership Card -->
                <div id="sidebarMembershipCard" class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-3">
                    <!-- Injected dynamically -->
                </div>

                <!-- Urgent Crisis Info Card -->
                <div class="bg-gradient-to-br from-white to-rose-50/50 p-5 rounded-2xl border border-rose-100 shadow-sm space-y-4">
                    <div class="flex items-center gap-2.5 text-rose-800 font-bold text-base">
                        <div class="w-8 h-8 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600 shrink-0">
                            <i class="fa-solid fa-phone-volume"></i>
                        </div>
                        <h3>Global Crisis Support</h3>
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed">
                        If you are feeling overwhelmed or in immediate danger, free and confidential support is available 24/7 globally:
                    </p>
                    <div class="space-y-2 text-xs">
                        <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-3 bg-white rounded-xl border border-rose-100 hover:border-rose-300 transition group font-medium">
                            <div>
                                <div class="font-bold text-gray-800">Find A Helpline</div>
                                <div class="text-[11px] text-gray-500">Global Directory (Free 24/7)</div>
                            </div>
                            <span class="text-rose-600 font-bold group-hover:underline text-[11px]">Browse →</span>
                        </a>
                        <a href="tel:988" class="flex items-center justify-between p-3 bg-white rounded-xl border border-rose-100 hover:border-rose-300 transition group font-medium">
                            <div>
                                <div class="font-bold text-gray-800">988 Suicide & Crisis Lifeline</div>
                                <div class="text-[11px] text-gray-500">US & Canada • Call or Text</div>
                            </div>
                            <span class="text-rose-600 font-bold">Call 988</span>
                        </a>
                    </div>
                    <button onclick="openHelplineModal()" class="w-full text-center text-xs text-sage-700 font-bold hover:underline pt-1">
                        View full international crisis directory →
                    </button>
                </div>

                <!-- Core Guidelines Card -->
                <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-3">
                    <div class="flex items-center gap-2 text-sage-800 font-bold text-sm">
                        <i class="fa-solid fa-scale-balanced text-sage-600"></i>
                        <h3>Community Pillars</h3>
                    </div>
                    <ul class="text-xs text-gray-600 space-y-2.5 leading-relaxed">
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-heart text-sage-600 mt-0.5"></i>
                            <span><strong>Zero Judgment:</strong> Respond with kindness. Never blame victims or invalidate feelings.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-user-shield text-sage-600 mt-0.5"></i>
                            <span><strong>Protect Anonymity:</strong> Do not share personal identities, real names, addresses, or contact info.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-hand-holding-medical text-sage-600 mt-0.5"></i>
                            <span><strong>Peer Support:</strong> We offer shared experience and empathy, not formal medical advice.</span>
                        </li>
                    </ul>
                </div>

                <!-- Footer info -->
                <div class="text-center text-xs text-gray-400 space-y-1">
                    <p>SafeSpace Global © 2026</p>
                    <p class="text-[11px]">Empathetic, ad-free & quiet since day one.</p>
                </div>

            </aside>

        </div>

        <!-- COMMUNITY RULES VIEW -->
        <div id="view-rules" class="hidden max-w-4xl mx-auto space-y-6">
            <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-200 shadow-sm space-y-6">
                <div class="border-b border-gray-100 pb-5">
                    <span class="text-xs font-bold uppercase tracking-wider text-sage-600">Our Pledge</span>
                    <h2 class="text-2xl font-extrabold text-gray-900 mt-1">Community Guidelines & Code of Conduct</h2>
                    <p class="text-sm text-gray-600 mt-1">SafeSpace exists to be a refuge. Every member agrees to honor these core principles.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-5 bg-sage-50/50 rounded-2xl border border-sage-100 space-y-2">
                        <div class="flex items-center gap-2 text-sage-800 font-bold text-base">
                            <i class="fa-solid fa-shield-halved text-sage-600"></i> 1. Strict Anonymity
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Never request or post personally identifiable information (real names, employers, social handles, or locations) about yourself or anyone else involved in a story.
                        </p>
                    </div>

                    <div class="p-5 bg-sage-50/50 rounded-2xl border border-sage-100 space-y-2">
                        <div class="flex items-center gap-2 text-sage-800 font-bold text-base">
                            <i class="fa-solid fa-ban text-rose-500"></i> 2. No Victim Blaming or Hate Speech
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            Cruelty, judgment, discrimination, harassment, or invalidation of someone's lived experience results in immediate removal and permanent revocation of access.
                        </p>
                    </div>

                    <div class="p-5 bg-sage-50/50 rounded-2xl border border-sage-100 space-y-2">
                        <div class="flex items-center gap-2 text-sage-800 font-bold text-base">
                            <i class="fa-solid fa-eye-slash text-amber-600"></i> 3. Trigger Warning Labels
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            When writing stories that involve explicit abuse, self-harm, or severe trauma, members must check the "Content Warning" option to allow others to prepare emotionally before reading.
                        </p>
                    </div>

                    <div class="p-5 bg-sage-50/50 rounded-2xl border border-sage-100 space-y-2">
                        <div class="flex items-center gap-2 text-sage-800 font-bold text-base">
                            <i class="fa-solid fa-comments text-sage-600"></i> 4. Supportive Conversations
                        </div>
                        <p class="text-xs text-gray-600 leading-relaxed">
                            When commenting, ask yourself: "Does this reply build up, offer solace, or validate?" Constructive peer warmth is our highest priority.
                        </p>
                    </div>
                </div>

                <div class="pt-4 text-center">
                    <button onclick="switchTab('feed')" class="bg-sage-600 hover:bg-sage-700 text-white font-bold text-sm px-6 py-2.5 rounded-xl transition">
                        Return to Stories Feed
                    </button>
                </div>
            </div>
        </div>

    </main>

    <!-- ==================== MODALS ==================== -->

    <!-- 1. REALISTIC €1 CHECKOUT MODAL -->
    <div id="paymentModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden border border-gray-100 animate-in fade-in zoom-in duration-200">
            <!-- Header -->
            <div class="bg-gradient-to-r from-sage-800 to-sage-700 text-white p-6 relative">
                <button onclick="closePaymentModal()" class="absolute top-4 right-4 text-white/80 hover:text-white text-xl">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 text-white text-xs font-semibold mb-2">
                    <i class="fa-solid fa-shield-halved"></i> Secure One-Time Checkout
                </div>
                <h3 class="text-xl font-bold">Unlock SafeSpace Lifetime Access</h3>
                <p class="text-xs text-sage-100 mt-1">Pay once, belong forever. No subscriptions, no ads.</p>
            </div>

            <!-- Body -->
            <div class="p-6 space-y-5">
                <!-- Summary -->
                <div class="bg-sage-50 border border-sage-200 rounded-2xl p-4 flex items-center justify-between">
                    <div>
                        <div class="font-bold text-gray-800 text-sm">SafeSpace Lifetime Pass</div>
                        <div class="text-xs text-gray-500">Unlocks reading, posting & commenting</div>
                    </div>
                    <div class="text-right">
                        <div class="text-2xl font-extrabold text-sage-700">€1.00</div>
                        <div class="text-[10px] uppercase font-bold text-gray-400">One-time fee</div>
                    </div>
                </div>

                <!-- Form -->
                <form id="paymentForm" onsubmit="processPayment(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1">Your Email (for receipt & access recovery)</label>
                        <input type="email" required placeholder="you@example.com" 
                            class="w-full text-xs p-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-1.5">Payment Method</label>
                        <div class="grid grid-cols-2 gap-2">
                            <label class="border border-sage-500 bg-sage-50/50 rounded-xl p-2.5 flex items-center gap-2 cursor-pointer text-xs font-medium text-gray-800">
                                <input type="radio" name="payMethod" checked class="accent-sage-600">
                                <i class="fa-solid fa-credit-card text-sage-700"></i> Card
                            </label>
                            <label class="border border-gray-200 hover:bg-gray-50 rounded-xl p-2.5 flex items-center gap-2 cursor-pointer text-xs font-medium text-gray-700">
                                <input type="radio" name="payMethod" class="accent-sage-600">
                                <i class="fa-brands fa-apple text-gray-800"></i> Apple Pay
                            </label>
                        </div>
                    </div>

                    <!-- Card details simulation -->
                    <div class="space-y-2.5">
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-500 mb-1">Cardholder Name (Simulated)</label>
                            <input type="text" placeholder="Alex Morgan" required 
                                class="w-full text-xs p-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-gray-500 mb-1">Card Number</label>
                            <div class="relative">
                                <input type="text" placeholder="4242 •••• •••• 4242" required maxlength="19"
                                    class="w-full text-xs p-2.5 pr-8 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none">
                                <i class="fa-solid fa-lock absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-[11px] font-semibold text-gray-500 mb-1">Expiry Date</label>
                                <input type="text" placeholder="MM/YY" required maxlength="5"
                                    class="w-full text-xs p-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-[11px] font-semibold text-gray-500 mb-1">CVC / CVV</label>
                                <input type="password" placeholder="•••" required maxlength="4"
                                    class="w-full text-xs p-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="text-[11px] text-gray-400 text-center leading-normal">
                        Simulated checkout demo. Completing activates instant member privileges.
                    </div>

                    <button type="submit" id="paySubmitBtn" class="w-full bg-sage-600 hover:bg-sage-700 text-white font-bold py-3 rounded-xl shadow-lg transition flex items-center justify-center gap-2 text-sm">
                        <span>Pay €1.00 & Unlock Lifetime Membership</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. CREATE STORY MODAL -->
    <div id="createStoryModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden border border-gray-100 max-h-[90vh] flex flex-col">
            <!-- Header -->
            <div class="bg-sage-800 text-white p-5 flex items-center justify-between shrink-0">
                <div class="flex items-center gap-2 font-bold text-lg">
                    <i class="fa-solid fa-feather-pointed"></i> Share Your Story
                </div>
                <button onclick="closeCreateStoryModal()" class="text-white/80 hover:text-white text-xl">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Form -->
            <form id="storyForm" onsubmit="handleStorySubmit(event)" class="p-6 space-y-4 overflow-y-auto flex-1">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Title or Brief Summary</label>
                    <input type="text" id="storyTitle" required placeholder="e.g., Feeling overwhelmed by expectations at work..." 
                        class="w-full text-sm p-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">Category</label>
                    <select id="storyCategory" class="w-full text-sm p-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none bg-white">
                        <option value="Everyday Struggles">🌧️ Everyday Struggles</option>
                        <option value="Abuse & Trauma">💔 Abuse & Trauma</option>
                        <option value="Healing & Advice">🌱 Healing & Advice</option>
                        <option value="Relationships & Family">🏠 Relationships & Family</option>
                    </select>
                </div>

                <!-- Author Identity Selection -->
                <div class="space-y-2 pt-1">
