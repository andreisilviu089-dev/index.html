    <!-- ==================== JAVASCRIPT LOGIC ==================== -->
    <script>
        // Sample Pre-populated Global English Stories
        const INITIAL_STORIES = [
            {
                id: 'story-1',
                title: 'It took me 3 years to realize emotional manipulation and isolation are real abuse.',
                category: 'Abuse & Trauma',
                author: 'Anonymous #318',
                time: '2 hours ago',
                isSensitive: true,
                content: `At the beginning, it felt like a fairy tale. He told me he loved me so intensely that he wanted us to spend all our free time together. Slowly, subtle comments started when I wanted to visit my family or grab coffee with long-time friends. "They don't really care about your future like I do," he would say.

Without even noticing, I had stopped texting my sister and was asking his permission for simple daily choices. Whenever I tried to express how suffocated I felt, he turned it around: "You're just being dramatic. I do everything for us."

Classic gaslighting. I am sharing this for anyone feeling smaller every single day just to fit into someone else's life: that is not love. I finally gathered the strength to leave last month. It is hard, but breathing freely again is worth every step.`,
                reactions: { empathetic: 42, strength: 58, gratitude: 29 },
                userReactions: {},
                comments: [
                    { id: 'c1', author: 'QuietHope', time: '1 hour ago', text: 'Huge congratulations on taking your freedom back. The first step away is always the hardest. Sending you peace!' },
                    { id: 'c2', author: 'Anonymous #904', time: '40 mins ago', text: 'Thank you for writing this. I felt like I was reading a mirror of my current situation. It gives me courage.' }
                ]
            },
            {
                id: 'story-2',
                title: 'Living on autopilot and constantly afraid I am letting everyone down.',
                category: 'Everyday Struggles',
                author: 'Elena_W',
                time: '5 hours ago',
                isSensitive: false,
                content: `I am 28 and for the past few months I wake up every morning with a tight knot in my chest. Work demands keep scaling up, my family expects me to be the cheerful caretaker, and inside I feel utterly depleted.

Yesterday I broke down crying over a dropped coffee mug. I feel ashamed to talk to my friends because I don't want to be a burden when everyone has their own problems. Has anyone else experienced this deep burn-out? How did you find your way back to yourself?`,
                reactions: { empathetic: 35, strength: 22, gratitude: 14 },
                userReactions: {},
                comments: [
                    { id: 'c3', author: 'Marcus_P', time: '3 hours ago', text: 'Crying over the mug was just your nervous system letting out built-up pressure. Give yourself permission to rest without guilt today!' }
                ]
            },
            {
                id: 'story-3',
                title: 'How do I establish boundaries with a toxic boss without risking my livelihood?',
                category: 'Healing & Advice',
                author: 'Anonymous #721',
                time: '1 day ago',
                isSensitive: false,
                content: `I work in a small remote team of 6 people. My manager has developed a habit of making demoralizing "jokes" at my expense during weekly team video calls. If I don't laugh along, he claims I "have no sense of humor" and am being overly sensitive.

I get severe anxiety on Sunday evenings knowing Monday morning is coming. Because I rely on this job to support my family, quitting immediately isn't an option. Has anyone successfully managed a situation like this?`,
                reactions: { empathetic: 19, strength: 28, gratitude: 11 },
                userReactions: {},
                comments: []
            }
        ];

        // State Management
        let isMember = false;
        let stories = [];
        let currentCategory = 'all';
        let currentTab = 'feed';
        let activeReportStoryId = null;

        // Initialize App
        document.addEventListener('DOMContentLoaded', () => {
            loadState();
            renderHeaderBadge();
            renderSidebarCard();
            renderStories();
        });

        function loadState() {
            const savedMember = localStorage.getItem('safespace_isMember');
            if (savedMember !== null) {
                isMember = JSON.parse(savedMember);
            }

            const savedStories = localStorage.getItem('safespace_stories');
            if (savedStories) {
                stories = JSON.parse(savedStories);
            } else {
                stories = INITIAL_STORIES;
                saveStories();
            }
        }

        function saveStories() {
            localStorage.setItem('safespace_stories', JSON.stringify(stories));
        }

        function setMemberState(val) {
            isMember = val;
            localStorage.setItem('safespace_isMember', JSON.stringify(isMember));
            renderHeaderBadge();
            renderSidebarCard();
            renderStories();

            const heroCallout = document.getElementById('heroVisitorCallout');
            if (heroCallout) {
                if (isMember) {
                    heroCallout.classList.add('hidden');
                } else {
                    heroCallout.classList.remove('hidden');
                }
            }
        }

        function toggleUserRole() {
            setMemberState(!isMember);
            showToast(isMember ? "Switched to LIFETIME MEMBER Mode (All features unlocked)" : "Switched to VISITOR Mode (Preview restriction active)", "info");
        }

        function switchTab(tab) {
            currentTab = tab;
            document.getElementById('view-feed').classList.toggle('hidden', tab !== 'feed');
            document.getElementById('view-rules').classList.toggle('hidden', tab !== 'rules');

            const feedBtn = document.getElementById('navTab-feed');
            const rulesBtn = document.getElementById('navTab-rules');

            if (tab === 'feed') {
                feedBtn.className = "hover:text-sage-700 transition pb-1 border-b-2 border-sage-600 text-sage-800 font-bold";
                rulesBtn.className = "hover:text-sage-700 transition pb-1 border-b-2 border-transparent font-medium";
            } else if (tab === 'rules') {
                rulesBtn.className = "hover:text-sage-700 transition pb-1 border-b-2 border-sage-600 text-sage-800 font-bold";
                feedBtn.className = "hover:text-sage-700 transition pb-1 border-b-2 border-transparent font-medium";
            }
        }

        function renderHeaderBadge() {
            const container = document.getElementById('statusBadgeContainer');
            if (!container) return;

            if (isMember) {
                container.innerHTML = `
                    <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold border border-emerald-200">
                        <i class="fa-solid fa-circle-check text-emerald-600"></i> Lifetime Member
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <button onclick="openPaymentModal()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-100 hover:bg-amber-200 text-amber-900 text-xs font-bold border border-amber-300 transition">
                        <i class="fa-solid fa-lock text-amber-700"></i> Visitor (€1 Unlock)
                    </button>
                `;
            }
        }

        function renderSidebarCard() {
            const card = document.getElementById('sidebarMembershipCard');
            if (!card) return;

            if (isMember) {
                card.innerHTML = `
                    <div class="flex items-center gap-2.5 text-sage-800 font-bold text-base">
                        <div class="w-8 h-8 rounded-xl bg-sage-100 flex items-center justify-center text-sage-700">
                            <i class="fa-solid fa-heart-circle-check"></i>
                        </div>
                        <h3>Lifetime Pass Active</h3>
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed">
                        Thank you for being a part of our quiet global refuge. Your account is active forever—feel free to read, reply, and post whenever you need.
                    </p>
                    <div class="pt-1 text-[11px] text-sage-700 font-bold flex items-center gap-1.5">
                        <i class="fa-solid fa-shield-halved"></i> Ad-Free & Protected
                    </div>
                `;
            } else {
                card.innerHTML = `
                    <div class="flex items-center gap-2.5 text-sage-800 font-bold text-base">
                        <div class="w-8 h-8 rounded-xl bg-sage-100 flex items-center justify-center text-sage-700">
                            <i class="fa-solid fa-sparkles"></i>
                        </div>
                        <h3>Lifetime Pass — €1.00</h3>
                    </div>
                    <p class="text-xs text-gray-600 leading-relaxed">
                        To maintain a quiet, compassionate space and keep out bots, trolls, and advertisers, we charge a single symbolic entry fee.
                    </p>
                    <ul class="text-xs text-gray-700 space-y-1.5 pt-1 font-medium">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-sage-600"></i> Read complete stories & replies</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-sage-600"></i> Share your story completely anonymously</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-sage-600"></i> No recurring subscription fees ever</li>
                    </ul>
                    <button onclick="openPaymentModal()" class="w-full mt-2 bg-sage-600 hover:bg-sage-700 text-white font-bold text-xs py-2.5 rounded-xl shadow transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-unlock"></i> Unlock Access (€1.00)
                    </button>
                `;
            }
        }

        function filterCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-sage-600', 'text-white');
                btn.classList.add('bg-gray-100', 'text-gray-700');
            });

            const activeBtn = document.getElementById(`catBtn-${cat}`);
            if (activeBtn) {
                activeBtn.classList.remove('bg-gray-100', 'text-gray-700');
                activeBtn.classList.add('bg-sage-600', 'text-white');
            }

            renderStories();
        }

        function renderStories() {
            const container = document.getElementById('storiesFeedContainer');
            const searchVal = (document.getElementById('searchInput')?.value || '').toLowerCase();
            if (!container) return;

            let filtered = stories.filter(s => {
                const matchesCat = currentCategory === 'all' || s.category === currentCategory;
                const matchesSearch = s.title.toLowerCase().includes(searchVal) || s.content.toLowerCase().includes(searchVal);
                return matchesCat && matchesSearch;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="bg-white p-8 rounded-2xl border border-gray-200 text-center space-y-3">
                        <div class="w-12 h-12 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mx-auto text-xl">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>
                        <h4 class="font-bold text-gray-700">No stories found</h4>
                        <p class="text-xs text-gray-500">Try adjusting your search terms or category filter.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(story => {
                let contentHtml = '';

                if (story.isSensitive && !story.revealedTW) {
                    contentHtml = `
                        <div class="bg-amber-50/90 border border-amber-200 p-4 rounded-xl text-center space-y-2 my-3">
                            <div class="text-amber-800 text-xs font-bold flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-triangle-exclamation"></i> Content Warning (Sensitive Topic)
                            </div>
                            <p class="text-[11px] text-amber-700">This post discusses sensitive personal trauma or emotional abuse.</p>
                            <button onclick="revealTW('${story.id}')" class="px-3 py-1.5 bg-amber-700 hover:bg-amber-800 text-white text-xs font-semibold rounded-lg transition">
                                Click to Reveal Story
                            </button>
                        </div>
                    `;
                } else if (!isMember) {
                    const previewText = story.content.substring(0, 140) + '...';
                    contentHtml = `
                        <div class="relative space-y-2 mt-2">
                            <p class="text-sm text-gray-700 leading-relaxed">${previewText}</p>
                            <div class="blur-preview text-sm text-gray-400 leading-relaxed select-none">
                                I realized that I couldn't keep suffering in silence. Finding a space where people actually listen without judgment changed everything...
                            </div>
                            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/80 to-white flex flex-col items-center justify-end pb-2 text-center">
                                <div class="bg-white/95 border border-sage-200 shadow-md p-4 rounded-2xl max-w-sm w-full mx-auto space-y-1.5">
                                    <div class="text-xs font-bold text-sage-800 flex items-center justify-center gap-1">
                                        <i class="fa-solid fa-lock"></i> Protected Member Content
                                    </div>
                                    <p class="text-[11px] text-gray-500 leading-normal">Unlock full story reading, reactions, and supportive replies with €1 lifetime access.</p>
                                    <button onclick="openPaymentModal()" class="w-full bg-sage-600 hover:bg-sage-700 text-white font-bold text-xs py-2 rounded-xl transition mt-1">
                                        Unlock Lifetime Membership (€1)
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                } else {
                    contentHtml = `
                        <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-line mt-2">${story.content}</p>
                    `;
                }

                const userReacted = story.userReactions || {};

                return `
                    <article class="bg-white p-5 sm:p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4 hover:border-sage-200 transition">
                        <div class="flex items-start justify-between gap-3">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sage-50 text-sage-700 border border-sage-200">
                                        ${story.category}
                                    </span>
                                    <span class="text-xs text-gray-400 font-medium">${story.time}</span>
                                </div>
                                <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">${story.title}</h3>
                            </div>
                            <span class="text-xs font-semibold text-gray-500 bg-gray-100 px-2.5 py-1 rounded-lg shrink-0">
                                <i class="fa-solid fa-user-shield text-sage-600 mr-1"></i> ${story.author}
                            </span>
                        </div>

                        ${contentHtml}

                        <div class="pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">
                            <div class="flex items-center gap-1.5 flex-wrap text-xs">
                                <button onclick="reactToStory('${story.id}', 'empathetic')" 
                                    class="px-3 py-1.5 rounded-xl border ${userReacted.empathetic ? 'bg-sage-100 border-sage-400 text-sage-800' : 'border-gray-200 hover:bg-gray-50 text-gray-700'} transition flex items-center gap-1.5 font-medium">
                                    <span>🫂 I hear you</span>
                                    <span class="font-bold">${story.reactions.empathetic || 0}</span>
                                </button>
                                <button onclick="reactToStory('${story.id}', 'strength')" 
                                    class="px-3 py-1.5 rounded-xl border ${userReacted.strength ? 'bg-sage-100 border-sage-400 text-sage-800' : 'border-gray-200 hover:bg-gray-50 text-gray-700'} transition flex items-center gap-1.5 font-medium">
                                    <span>💪 Sending strength</span>
                                    <span class="font-bold">${story.reactions.strength || 0}</span>
                                </button>
                                <button onclick="reactToStory('${story.id}', 'gratitude')" 
                                    class="px-3 py-1.5 rounded-xl border ${userReacted.gratitude ? 'bg-sage-100 border-sage-400 text-sage-800' : 'border-gray-200 hover:bg-gray-50 text-gray-700'} transition flex items-center gap-1.5 font-medium">
                                    <span>❤️ Thank you for sharing</span>
                                    <span class="font-bold">${story.reactions.gratitude || 0}</span>
                                </button>
                            </div>

                            <div class="flex items-center gap-3 text-xs">
                                <button onclick="toggleComments('${story.id}')" class="text-sage-700 hover:text-sage-800 font-bold flex items-center gap-1.5">
                                    <i class="fa-regular fa-comment-dots"></i> Replies (${story.comments ? story.comments.length : 0})
                                </button>
                                <button onclick="openReportModal('${story.id}')" class="text-gray-400 hover:text-rose-500 transition" title="Report Post">
                                    <i class="fa-regular fa-flag"></i>
                                </button>
                            </div>
                        </div>

                        <div id="commentsSection-${story.id}" class="hidden pt-3 border-t border-gray-100 space-y-3 bg-gray-50/70 p-4 rounded-xl">
                            <h4 class="text-xs font-bold text-gray-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-comments text-sage-600"></i> Supportive Community Replies
                            </h4>

                            <div class="space-y-2.5">
                                ${(!story.comments || story.comments.length === 0) 
                                    ? `<p class="text-xs text-gray-400 italic">No replies yet. Be the first to send a comforting message!</p>`
                                    : story.comments.map(c => `
                                        <div class="bg-white p-3 rounded-xl border border-gray-200 space-y-1 text-xs">
                                            <div class="flex justify-between items-center text-gray-500 font-medium">
                                                <span class="font-bold text-sage-800"><i class="fa-solid fa-circle-user mr-1"></i> ${c.author}</span>
                                                <span class="text-[10px]">${c.time}</span>
                                            </div>
                                            <p class="text-gray-700 leading-relaxed">${c.text}</p>
                                        </div>
                                    `).join('')
                                }
                            </div>

                            ${isMember ? `
                                <form onsubmit="handleAddComment(event, '${story.id}')" class="pt-2 space-y-2">
                                    <textarea required rows="2" placeholder="Write a gentle, supportive reply..." 
                                        class="w-full text-xs p-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-sage-500 focus:outline-none bg-white leading-relaxed"></textarea>
                                    <div class="flex items-center justify-between">
                                        <label class="text-[11px] text-gray-500 flex items-center gap-1 cursor-pointer">
                                            <input type="checkbox" id="commentAnonCheck-${story.id}" checked class="accent-sage-600 rounded">
                                            Post anonymously
                                        </label>
                                        <button type="submit" class="px-4 py-2 bg-sage-600 hover:bg-sage-700 text-white font-bold text-xs rounded-xl transition shadow-sm">
                                            Send Reply
                                        </button>
                                    </div>
                                </form>
                            ` : `
                                <div class="bg-white p-3.5 rounded-xl border border-sage-200 text-center space-y-1">
                                    <p class="text-xs text-gray-600">Want to offer solace to this author?</p>
                                    <button onclick="openPaymentModal()" class="text-xs text-sage-700 font-bold hover:underline">
                                        Unlock lifetime access (€1.00) to reply →
                                    </button>
                                </div>
                            `}
                        </div>
                    </article>
                `;
            }).join('');
        }

        function revealTW(storyId) {
            const story = stories.find(s => s.id === storyId);
            if (story) {
                story.revealedTW = true;
                renderStories();
            }
        }

        function reactToStory(storyId, type) {
            if (!isMember) {
                openPaymentModal();
                showToast("Unlock membership (€1) to send supportive reactions.", "info");
                return;
            }

            const story = stories.find(s => s.id === storyId);
            if (!story) return;

            if (!story.userReactions) story.userReactions = {};
            if (!story.reactions) story.reactions = { empathetic: 0, strength: 0, gratitude: 0 };

            if (story.userReactions[type]) {
                story.reactions[type]--;
                story.userReactions[type] = false;
            } else {
                story.reactions[type] = (story.reactions[type] || 0) + 1;
                story.userReactions[type] = true;
            }

            saveStories();
            renderStories();
        }

        function toggleComments(storyId) {
            const sec = document.getElementById(`commentsSection-${storyId}`);
            if (sec) sec.classList.toggle('hidden');
        }

        function handleAddComment(e, storyId) {
            e.preventDefault();
            const form = e.target;
            const textarea = form.querySelector('textarea');
            const isAnon = form.querySelector(`#commentAnonCheck-${storyId}`)?.checked;
            
            const text = textarea.value.trim();
            if (!text) return;

            const story = stories.find(s => s.id === storyId);
            if (story) {
                if (!story.comments) story.comments = [];
                const randomId = Math.floor(100 + Math.random() * 900);
                story.comments.push({
                    id: 'c-' + Date.now(),
                    author: isAnon ? `Anonymous #${randomId}` : 'SafeSpace Member',
                    time: 'Just now',
                    text: text
                });
                saveStories();
                renderStories();
                showToast("Your supportive reply has been shared.", "success");
            }
        }

        function handleCreateStoryClick() {
            if (!isMember) {
                openPaymentModal();
                showToast("Please unlock lifetime access (€1.00) to publish a story.", "info");
            } else {
                openCreateStoryModal();
            }
        }

        function handleStorySubmit(e) {
            e.preventDefault();
            const title = document.getElementById('storyTitle').value.trim();
            const category = document.getElementById('storyCategory').value;
            const content = document.getElementById('storyContent').value.trim();
            const isSensitive = document.getElementById('storyTW').checked;

            const authorOption = document.querySelector('input[name="authorOption"]:checked').value;
            let authorName = 'Anonymous #' + Math.floor(100 + Math.random() * 900);

            if (authorOption === 'pseudonym') {
                const customPseudonym = document.getElementById('storyPseudonym').value.trim();
                if (customPseudonym) authorName = customPseudonym;
            }

            const newStory = {
                id: 'story-' + Date.now(),
                title: title,
                category: category,
                author: authorName,
                time: 'Just now',
                isSensitive: isSensitive,
                content: content,
                reactions: { empathetic: 1, strength: 1, gratitude: 1 },
                userReactions: { empathetic: true },
                comments: []
            };

            stories.unshift(newStory);
            saveStories();
            closeCreateStoryModal();
            renderStories();
            showToast("Your story has been safely published.", "success");
            document.getElementById('storyForm').reset();
        }

        function toggleAuthorInput() {
            const authorOption = document.querySelector('input[name="authorOption"]:checked').value;
            const container = document.getElementById('pseudonymInputContainer');
            if (authorOption === 'pseudonym') {
                container.classList.remove('hidden');
            } else {
                container.classList.add('hidden');
            }
        }

        function processPayment(e) {
            e.preventDefault();
            const btn = document.getElementById('paySubmitBtn');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Processing €1.00 Payment...`;

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = `<span>Pay €1.00 & Unlock Lifetime Membership</span>`;
                closePaymentModal();
                setMemberState(true);
                showToast("🎉 Payment confirmed! Welcome to SafeSpace.", "success");
            }, 1200);
        }

        function openReportModal(storyId) {
            activeReportStoryId = storyId;
            document.getElementById('reportModal').classList.remove('hidden');
        }
        function closeReportModal() {
            document.getElementById('reportModal').classList.add('hidden');
            activeReportStoryId = null;
        }
        function submitReport() {
            closeReportModal();
            showToast("Report submitted to our moderation team. Thank you for keeping us safe.", "success");
        }

        function openPaymentModal() { document.getElementById('paymentModal').classList.remove('hidden'); }
        function closePaymentModal() { document.getElementById('paymentModal').classList.add('hidden'); }

        function openCreateStoryModal() { document.getElementById('createStoryModal').classList.remove('hidden'); }
        function closeCreateStoryModal() { document.getElementById('createStoryModal').classList.add('hidden'); }

        function openHelplineModal() { document.getElementById('helplineModal').classList.remove('hidden'); }
        function closeHelplineModal() { document.getElementById('helplineModal').classList.add('hidden'); }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold border text-white transition-all transform duration-300 translate-y-2 bg-sage-800 border-sage-700`;

            if (type === 'success') {
                toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold border text-white transition-all transform duration-300 translate-y-2 bg-emerald-700 border-emerald-600`;
            } else if (type === 'error') {
                toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-2xl shadow-xl text-xs font-semibold border text-white transition-all transform duration-300 translate-y-2 bg-rose-700 border-rose-600`;
            }

            toast.innerHTML = `
                <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-info'} text-sm"></i>
                <span>${message}</span>
            `;

            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-2'), 10);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }
    </script>
</body>
</html>
